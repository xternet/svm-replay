{
  "name": "@xternet/svm-replay",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "author": "xternet",
  "repository": { "type": "git", "url": "git+https://github.com/xternet/svm-replay.git", "directory": "src/bindings/typescript" },
  "homepage": "https://github.com/xternet/svm-replay",
  "bugs": { "url": "https://github.com/xternet/svm-replay/issues" },
  "keywords": ["solana", "svm", "replay", "simulation", "debugging"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
